<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Deliberately not a Windows target and with no reference to mRemoteNG: this
      library only talks to the Blinky Access connections API, so it can be used from
      a service, a console tool or tests just as well as from the application.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64;arm64</Platforms>
    <Configurations>Debug;Release;Debug Portable;Release Self-Contained;Deploy to github</Configurations>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
