<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?include $(sys.CURRENTDIR)Includes\Config.wxi?>

  <Package Name="$(var.ProductNameWithPlatform)"
           Manufacturer="$(var.Company)"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="$(var.ProductLanguage)"
           Scope="perMachine"
           InstallerVersion="500"
           Compressed="yes">

    <!--
      The old product is removed before the new files are laid down. With the
      previous "afterInstallExecute" schedule the new files went in first, and
      Windows Installer skips a file whose version is not higher than the one on
      disk: every helper assembly here is version 1.0.0.0 for ever, so those kept
      their old copy and the application loaded stale code.

      AllowSameVersionUpgrades matters because Windows Installer ignores the
      fourth version field, and nightly builds differ only in that field.
    -->
    <MajorUpgrade DowngradeErrorMessage="!(loc.Upgrade_NewerVersionInstalled)"
                  Schedule="afterInstallInitialize"
                  AllowSameVersionUpgrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="MsiLogging" Value="v" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://mremoteng.org" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize" Sequence="execute" />
    <Property Id="MAINEXE" Value="$(var.ExeProcessName)" />

    <!-- Reuse the directory of an existing installation -->
    <Property Id="INSTALLDIR">
      <RegistrySearch Id="mRemoteNGRegistry" Type="raw" Root="HKLM" Key="Software\mRemoteNG" Name="InstallDir" />
    </Property>

    <Property Id="LEGACYVERSIONINSTALLED" Value="0" />

    <Icon Id="AppIcon.ico" SourceFile="Resources\AppIcon.ico" />

    <!-- Administrator rights are required for a per-machine install -->
    <Launch Condition="Privileged" Message="!(loc.Install_NeedToBeAdminToInstall)" />

    <!--
      mRemoteNG runs on .NET 10. The check reports 0 when a compatible desktop
      runtime is present; anything else means missing or too old.
    -->
    <netfx:DotNetCompatibilityCheck Id="DotNet10Check"
                                    RuntimeType="desktop"
                                    Platform="x64"
                                    Version="10.0.0"
                                    Property="DOTNET10CHECKRESULT" />
    <Launch Condition="Installed OR (IGNOREPREREQUISITES = 1) OR DOTNET10CHECKRESULT = &quot;0&quot;"
            Message="!(loc.Install_NeedDotNetRuntime)" />

    <!-- Uninstall a pre-1.76 NSIS based installation before laying down files -->
    <Binary Id="CustomActionsBinary" SourceFile="$(var.CustomActionsPath)\CustomActions.CA.dll" />
    <CustomAction Id="CheckIfLegacyVersionInstalled" BinaryRef="CustomActionsBinary"
                  DllEntry="IsLegacyVersionInstalled" Execute="immediate" Return="check" />
    <CustomAction Id="UninstallLegacyVersion" BinaryRef="CustomActionsBinary"
                  DllEntry="UninstallLegacyVersion" Execute="immediate" Return="check" />

    <InstallUISequence>
      <Custom Action="CheckIfLegacyVersionInstalled" After="LaunchConditions" />
      <Custom Action="UninstallLegacyVersion" After="CheckIfLegacyVersionInstalled"
              Condition="(NOT Installed) AND (LEGACYVERSIONINSTALLED = 1)" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="CheckIfLegacyVersionInstalled" After="LaunchConditions" />
      <Custom Action="UninstallLegacyVersion" After="CheckIfLegacyVersionInstalled"
              Condition="(NOT Installed) AND (LEGACYVERSIONINSTALLED = 1)" />
    </InstallExecuteSequence>

    <Feature Id="F.MinimalFeature" Title="$(var.ProductName)" AllowAbsent="no"
             ConfigurableDirectory="INSTALLDIR" Display="expand" Level="1">
      <ComponentGroupRef Id="MandatoryComponents" />
      <ComponentRef Id="C.MainExe" />
      <ComponentGroupRef Id="CG.ProjectInfoFiles" />
      <ComponentRef Id="C.RegistryEntries" />
    </Feature>

    <Feature Id="F.DesktopShortcut" Title="!(loc.Feature_DesktopShortcut)" AllowAdvertise="no" Level="1">
      <ComponentRef Id="C.DesktopShortcut" />
    </Feature>

    <Feature Id="F.ApplicationStartMenuShortcut" Title="!(loc.Feature_StartMenuShortcut)" AllowAdvertise="no" Level="1">
      <ComponentRef Id="C.ApplicationStartMenuShortcut" />
    </Feature>

    <ui:WixUI Id="WixUI_FeatureTree" InstallDirectory="INSTALLDIR" />

    <WixVariable Id="WixUILicenseRtf" Value="Resources\License.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="Resources\Installer_Side.png" />
    <WixVariable Id="WixUIBannerBmp" Value="Resources\Installer_Header.png" />

    <!-- Offer to start the application from the last page -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.FinishPage_LaunchMremoteNow)" />
    <Property Id="WixShellExecTarget" Value="[#MainExeFile]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" Impersonate="yes" BinaryRef="Wix4UtilCA_X64" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>
</Wix>
