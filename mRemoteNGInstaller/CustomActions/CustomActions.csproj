<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Managed custom actions run inside msiexec, which hosts the .NET Framework -->
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CustomActions</RootNamespace>
    <AssemblyName>CustomActions</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Configurations>Debug;Release;Release Installer;Debug Portable;Release Portable;Deploy to github</Configurations>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <!-- WindowsInstaller is the managed API, CustomAction packages the .CA.dll -->
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" />
    <PackageReference Include="WixToolset.Dtf.CustomAction" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="CustomAction.config" />
  </ItemGroup>
</Project>
